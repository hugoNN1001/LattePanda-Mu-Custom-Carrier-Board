		(uuid "d0684fc9-31fa-46d4-8363-60d62322fddc")
	)
	(text "Sleeping State Signal\n- SLS_S0:\n - S0 (Working): HIGH\n - S3 (Sleeping): LOW\n - S4 (Hibernation): LOW\n - S5 (Soft Off): LOW\n- SLS_S3:\n - S0 (Working): HIGH\n - S3 (Sleeping): HIGH\n - S4 (Hibernation): LOW\n - S5 (Soft Off): LOW"
		(exclude_from_sim no)
		(at 213.36 54.864 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "d7012fd0-fe2a-4a11-b202-cc40d29e1f49")
	)
