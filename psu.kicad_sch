	(text "~{PWR_LED}/~{PSON} relies on the 10k pull-up resistor to output HIGH only in S0 (working).\nIt cannot source enough current (only 0.33mA) to drive an LED indicator, so a NMOS is needed.\n\nUse SLS_S3 to enable 5V/3.3V in both \nS0(working) and S3(sleep) states"
		(exclude_from_sim no)
		(at 296.164 252.984 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "703c0e63-cdab-4fd9-9215-0968fe670291")
	)
	(text "R47 limits peak inrush current that charges the \ngate capacitance when mosfet is switched on.\nR49 is a pull-down resistor to ensure \nQ8 maintains a default off-state.\n\nD22 only illuminates in S0(working) state.\nOptional: add another LED to indicate sleeping state"
		(exclude_from_sim no)
		(at 296.164 239.522 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "83b5473f-9ff1-4a93-b7d7-8c61a48264e7")
	)
	(text "Vout = 0.6*(21.5+4.7)/4.7 = 3.446V"
