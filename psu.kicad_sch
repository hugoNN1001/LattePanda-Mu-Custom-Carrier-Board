	(text "Auto Power-On:\n\nCan add an auto power-on circuit to auto boot when power is applied.\nThe circuit simulates the physical action of pressing the power button.\nSee design guide for implementation.\n\nhttps://docs.lattepanda.com/content/mu_edition/design_guide_auto_power_on/\n"
		(exclude_from_sim no)
		(at 296.164 274.828 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b2b738b5-5b8f-49af-af0e-7a870d3a7f2f")
	)
	(text "SY8253ADC 23V 3A 500kHz"
		(exclude_from_sim no)
		(at 393.954 125.73 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "bc8c7e66-a8d0-43f4-8f0d-d402ed45dd9f")
	)
	(text "LattePanda Mu has internal 10k pull-up resistor.\nWhen switch is closed, capacitors discharge through it and pin is driven low.\n\n~{PWR_SW}\nA LOW pulse durection of > 125ms is recomended for reliable detection.\nHolding LOW for > 4s will trigger a force shutdown (how?)\n\n`{RST_SW}\nA LOW pulse duration of > 16ms is recommended to for successful reset.\n\nESD diodes have Vrwm = 5V as recommended."
		(exclude_from_sim no)
		(at 431.292 311.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bec08b8b-ca4a-4c8a-beb8-5be508d60ef1")
	)
