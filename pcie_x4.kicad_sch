	(text "Hot-plugging is NOT supported on any PCIe lanes. \nPower off the system and disconnect the power supply before inserting or removing PCIe devices.\n\n3.3Vaux powers the PCIe device so it can still wake up the host when\nthe host is in sleep state. \nAlthought the feature is not implemented here because there is no \nstandby power supplied by the PSU (~{PE_WAKE} is redundant).\n\nPRSNT - Presence Detect\n\nRSVD - Reserved"
		(exclude_from_sim no)
		(at 184.404 34.798 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ffac8a70-dc9d-4cab-a317-fd9d2fdbe3d7")
	)
